{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACRUX",
  "version": "0.0.1",
  "identifier": "com.acrux.plotstation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "container",
        "title": "ACRUX - Container",
        "width": 1366,
        "height": 768,
        "minWidth": 1180,
        "minHeight": 700,
        "x": 0,
        "y": 0
      },
      {
        "label": "pocketqube",
        "title": "ACRUX - PocketQube",
        "width": 1366,
        "height": 768,
        "minWidth": 1180,
        "minHeight": 700,
        "x": 80,
        "y": 80
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
